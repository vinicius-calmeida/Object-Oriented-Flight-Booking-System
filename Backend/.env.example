# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Nome do modelo a usar. Verifique o nome atual em https://ai.google.dev/gemini-api/docs/models
# Recomendado: gemini-1.5-flash (gratuito, rápido, suficiente para extrair filtros)
LLM_MODEL=

# Porta do servidor (opcional; padrão: 3000)
# PORT=3000
